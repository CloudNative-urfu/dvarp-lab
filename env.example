# env.example — шаблон переменных окружения dvarp-lab.
#
# dev.py (uv run python scripts/dev.py) задаёт ВСЁ это автоматически — файл нужен
# для ручного/VPS/PostgreSQL развёртывания.
# Для статьи base_url — только 127.0.0.1 (проверяет lab/nominal.py); не-локальные
# эндпоинты — только флаг allow_remote_llm (проверка работоспособности, не статья).
# Ключи — только в env процесса; в журналы, кассеты и манифесты не попадают.

# ===== URLs сервисов (дефолты ниже; меняются при нестандартных портах) =====
# LAB_SHOP_URL=http://127.0.0.1:9411
# LAB_TRAFFIC_URL=http://127.0.0.1:9412
# LAB_ATTACK_URL=http://127.0.0.1:9413
# LAB_FILTER_URL=http://127.0.0.1:9414
# LAB_METRICS_URL=http://127.0.0.1:9415

# ===== Хранилища (SQLite для dev; PostgreSQL — для сервера прогонов) =====
# SQLite:  sqlite:///<путь>/<файл>.db
# Postgres: postgresql+asyncpg://<user>:<pass>@127.0.0.1:5432/<db>
# LAB_SHOP_DB_URL=            # БД магазина (shop_svc)
# LAB_SHOP_RUNTIME=           # каталог runtime-файлов shop: журналы, снапшоты
# LAB_RAW_DB_URL=             # сырая БД: пишет filter_svc, читает metrics_svc (read-only)
# LAB_RAW_DIR=                # JSONL-хеш-цепочка + кассеты вызовов моделей (filter_svc)
# LAB_METRICS_DB_URL=         # БД результатов metrics_svc
# LAB_RUNS_DIR=               # манифесты кампаний (launcher/ui)

# ===== Live-LLM (пусто = stub-режим) =====
# base_url — OpenAI-совместимый /v1/chat/completions; для статьи — только 127.0.0.1
#
# Пример проверки работоспособности через прокси AITunnel (НЕ для статьи:
# запускать с галочкой Remote LLM / --allow-remote-llm):
# LAB_CUSTOMER_LLM_BASE_URL=https://api.aitunnel.ru/v1
# LAB_CUSTOMER_LLM_MODEL=openai/gpt-4o-mini
# LAB_ATTACKER_LLM_BASE_URL=https://api.aitunnel.ru/v1
# LAB_ATTACKER_LLM_MODEL=openai/gpt-4o-mini
# LAB_AGENT_LLM_BASE_URL=https://api.aitunnel.ru/v1
# RESEARCH_LLM_BASE_URL=https://api.aitunnel.ru/v1   # агент shop_svc читает канонические имена
# RESEARCH_LLM_MODEL=openai/gpt-4o-mini
# LAB_ALLOW_REMOTE_LLM=1                             # обход локальности у shop-агента
# Ключи прокси: только в env, в журналы/кассеты/манифесты не попадают
# LAB_CUSTOMER_LLM_API_KEY=sk-aitunnel-...
# LAB_ATTACKER_LLM_API_KEY=sk-aitunnel-...
# RESEARCH_LLM_API_KEY=sk-aitunnel-...               # ключ агента shop_svc
