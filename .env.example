# .env.example — переменные окружения dvarp-lab с дефолтами.
#
# dev.py (uv run python scripts/dev.py) задаёт ВСЁ это автоматически — файл нужен
# для ручного/VPS/PostgreSQL развёртывания: скопируйте в .env и при необходимости
# поправьте пути. Значения ниже совпадают с дефолтами кода (services/*, launcher).
# Для статьи base_url — только 127.0.0.1; любой другой http(s) эндпоинт допускается
# без флагов и автоматически маркируется remote (метрики его пропускают).
# Ключи — только в env процесса; в журналы, кассеты и манифесты не попадают.

# ===== URLs сервисов (дефолты ниже; меняются при нестандартных портах) =====
LAB_SHOP_URL=http://127.0.0.1:9411
LAB_TRAFFIC_URL=http://127.0.0.1:9412
LAB_ATTACK_URL=http://127.0.0.1:9413
LAB_FILTER_URL=http://127.0.0.1:9414
LAB_METRICS_URL=http://127.0.0.1:9415

# ===== Хранилища (SQLite для dev; PostgreSQL — для сервера прогонов) =====
# SQLite:  sqlite:///<путь>/<файл>.db
# Postgres: postgresql+asyncpg://<user>:<pass>@127.0.0.1:5432/<db>
LAB_SHOP_DB_URL=sqlite:///var/shop/shop.db          # БД магазина (shop_svc)
LAB_SHOP_RUNTIME=var/shop                           # каталог runtime-файлов shop: журналы, снапшоты
# LAB_PROMPT_CANARY=                                # канарейка утечки промпта (≥8 симв.); пусто — синтетическая на каждый /reset
LAB_RAW_DB_URL=sqlite:///./runs/raw.db              # сырая БД: пишет filter_svc, читает metrics_svc (read-only)
LAB_RAW_DIR=./runs/raw                              # JSONL-хеш-цепочка + кассеты вызовов моделей (filter_svc)
LAB_METRICS_DB_URL=sqlite:///./runs/metrics.db      # БД результатов metrics_svc
LAB_RUNS_DIR=runs                                   # манифесты кампаний (launcher/ui)

# ===== Live-LLM (пусто/не задано = stub-режим) =====
# base_url — OpenAI-совместимый /v1/chat/completions; для статьи — только 127.0.0.1.
# Имена моделей НЕ задаются дефолтами: ростер — frozen/llm.json (замороженная
# характеристика); внешние имена моделей допускаются без записи в заморозку
# (пин remote-verification).
#
# Пример проверки работоспособности через прокси (НЕ для статьи; флаги не нужны —
# прогон маркируется remote автоматически):
# LAB_CUSTOMER_LLM_BASE_URL=https://<прокси>/v1
# LAB_CUSTOMER_LLM_MODEL=<имя-модели-у-прокси>
# LAB_ATTACKER_LLM_BASE_URL=https://<прокси>/v1
# LAB_ATTACKER_LLM_MODEL=<имя-модели-у-прокси>
# LAB_AGENT_LLM_BASE_URL=https://<прокси>/v1
# RESEARCH_LLM_BASE_URL=https://<прокси>/v1          # агент shop_svc читает канонические имена
# RESEARCH_LLM_MODEL=<имя-модели-у-прокси>
# RESEARCH_LLM_PARAMS_B=8                            # размер, если его нет в имени модели (fail-closed)
# Ключи прокси: только в env, в журналы/кассеты/манифесты не попадают
# LAB_CUSTOMER_LLM_API_KEY=sk-...
# LAB_ATTACKER_LLM_API_KEY=sk-...
# RESEARCH_LLM_API_KEY=sk-...                        # ключ агента shop_svc
